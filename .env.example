# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proyecto_cv
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proyecto_cv?schema=public"

# Seguridad y Sesiones (cambia AUTH_SECRET por una cadena aleatoria de >= 32 caracteres en producción)
AUTH_SECRET="cambia-esta-clave-secreta-por-una-segura-de-32-caracteres"

# Control de acceso y Multi-Tenant
ALLOW_SIGNUP="false"
PRIMARY_PROFILE_SLUG="mi-cv"

# Almacenamiento local de PDFs e imágenes
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
MAX_PDF_SIZE_MB="10"

# Usuario administrador inicial para seed (`pnpm db:seed`)
SEED_ADMIN_EMAIL="admin@proyecto-cv.local"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_ADMIN_NAME="Propietario CV"
